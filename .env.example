# Climate Sentinel Environment Variables

# LLM Providers (Optional - system includes offline heuristic fallback engine)
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Execution Mode: "auto", "gemini", "openai", "offline_heuristic"
AGENT_EXECUTION_MODE=auto

# Webhook Alert Destination (Optional Discord / Slack webhook for live alerts)
ALERT_WEBHOOK_URL=
